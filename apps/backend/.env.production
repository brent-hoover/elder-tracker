# Production environment variables
# These will be overridden by Railway environment variables

PORT=${{PORT}}
NODE_ENV=production

# Database (Railway PostgreSQL)
DB_HOST=${{PGHOST}}
DB_PORT=${{PGPORT}}
DB_USERNAME=${{PGUSER}}
DB_PASSWORD=${{PGPASSWORD}}
DB_DATABASE=${{PGDATABASE}}

# JWT Configuration
JWT_SECRET=${{JWT_SECRET}}
JWT_EXPIRATION=7d