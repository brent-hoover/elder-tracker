{
  "name": "elder-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run start:dev --workspace=@elder-tracker/backend",
    "dev:frontend": "npm run dev --workspace=@elder-tracker/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=@elder-tracker/backend",
    "build:frontend": "npm run build --workspace=@elder-tracker/frontend",
    "start": "npm run start:prod --workspace=@elder-tracker/backend",
    "start:backend": "npm run start:prod --workspace=@elder-tracker/backend",
    "start:frontend": "npm run preview --workspace=@elder-tracker/frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}